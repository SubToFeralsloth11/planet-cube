; Engine configuration file.
config_version=5

[application]
config/name="Planet Cube"
config/description="Survive, mine and build on a cube-shaped planet, then escape it."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
B="*res://scripts/blocks.gd"
T="*res://scripts/textures.gd"
Sfx="*res://scripts/sfx.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
